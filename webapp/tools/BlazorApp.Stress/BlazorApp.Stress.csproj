<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stress tool (plan section 4): starts several real Server processes on one data folder,
       sends many colliding updates through the HTTP API, then checks nothing was lost. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Opens the store by strategy name to read the folder back; Shared brings the DTOs, routes and rules. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorApp.Services\BlazorApp.Services.csproj" />
  </ItemGroup>

  <!-- Build the Server first, but run it as separate processes rather than loading it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorApp.Server\BlazorApp.Server.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Where the Server was built and its project folder (the servers' content root). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ServerProjectDir</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../src/BlazorApp.Server'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ServerDll</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../src/BlazorApp.Server/bin/$(Configuration)/$(TargetFramework)/BlazorApp.Server.dll'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
