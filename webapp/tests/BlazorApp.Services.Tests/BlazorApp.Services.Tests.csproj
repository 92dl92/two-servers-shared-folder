<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the Services layer and the rules in Shared. -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorApp.Services\BlazorApp.Services.csproj" />
    <ProjectReference Include="..\BlazorApp.StoreHelper\BlazorApp.StoreHelper.csproj" />
  </ItemGroup>

  <!-- The storage tests run the helper as separate processes from its own build output. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>StoreHelperDll</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../BlazorApp.StoreHelper/bin/$(Configuration)/$(TargetFramework)/BlazorApp.StoreHelper.dll'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The Server's users.json, so a test can check the file that actually ships. -->
  <ItemGroup>
    <None Include="..\..\src\BlazorApp.Server\users.json" Link="users.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.0.0" />
  </ItemGroup>

</Project>
